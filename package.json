  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@google-cloud/text-to-speech": "^7.1.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "~5.9.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.2"
  }
}
