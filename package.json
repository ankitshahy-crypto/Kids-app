{
  "name": "kids-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/copy-spa-fallback.mjs",
    "preview": "vite preview",
